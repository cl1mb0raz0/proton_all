# Copy To .env And Fill In:  cp .env.example .env
# The Proton Login Is Not Here: Type It In The Browser (In / Out In The Sidebar).

# --- The Top Folder Proton All Can See On This Machine ---------------------------
# The Browser Lets You Choose Or Create A Folder Inside It For Your Files.
PDRIVE_DATA_DIR=/home/you/ProtonDrive

# --- Optional ------------------------------------------------------------------
# Your User And Group Ids, So Downloaded Files Are Yours (Run `id -u` And `id -g`).
PUID=1000
PGID=1000
# Host Port For The Web Interface.
PDRIVE_PORT=8765
# Fixed Access Key. Empty: A New One Is Printed In The Logs At Every Start.
PDRIVE_KEY=
