class ApiError(Exception):
    def __init__(self, status, message):
        super().__init__(message)
        self.status = status
        self.message = message


# -------------------------------------------------------------------------- Rclone
class Rclone:
    """Runs Rclone One Command At A Time.

    Proton Rotates Session Tokens, So Two Rclone Processes Using The Same
    Config At Once Are Asked To Wait (409) Instead Of Racing Each Other.
    """

    def __init__(self, binary):
        self.bin = binary
        self.lock = threading.Lock()
        self.remote = REMOTE
        self.version = ""

    def locate(self):
        for cand in (self.bin, shutil.which("rclone")):
            if not cand or not os.access(cand, os.X_OK):
                continue
            out = subprocess.run([cand, "help", "backends"], capture_output=True, text=True)
            if "protondrive" in out.stdout.lower():
                self.bin = cand
                self.version = subprocess.run([cand, "version"], capture_output=True,
                                              text=True).stdout.splitlines()[0]
                return True
        return False

    def remotes(self):
        out = subprocess.run([self.bin, "config", "dump"], capture_output=True, text=True)
        try:
            data = json.loads(out.stdout or "{}")
        except ValueError:
            return []
        return sorted(n for n, c in data.items() if c.get("type") == "protondrive")

    def pick_remote(self):
        if self.remote:
            return
        found = self.remotes()
        self.remote = found[0] if found else DEFAULT_REMOTE

    def spec(self, path):
        parts = [p for p in path.split("/") if p]
        if any(p in (".", "..") for p in parts) or "\0" in path:
            raise ApiError(400, "Invalid remote path.")
        return f"{self.remote}:{'/'.join(parts)}"

    def config(self):
        """The Saved Settings Of The Remote ({} If It Does Not Exist)."""
        out = subprocess.run([self.bin, "config", "dump"], capture_output=True, text=True)
        try:
            return json.loads(out.stdout or "{}").get(self.remote, {})
        except ValueError:
            return {}

    def logged_in(self):
        """True When The Remote Exists And Holds A Saved Proton Session."""
        cfg = self.config()
        return cfg.get("type") == "protondrive" and bool(cfg.get("client_refresh_token"))

    def account(self):
        return self.config().get("username", "")

    def _exec(self, args, **kw):
        return subprocess.run([self.bin, *args], capture_output=True, text=True,
                              errors="replace", **kw)

    def obscure(self, secret):
        return self._exec(["obscure", "-"], input=secret, timeout=30).stdout.strip()

    def login(self, username, password, mailbox, code):
        """Creates The Remote From The Form And Logs In Once.

        The 2FA Code Goes Only To The Environment Of That One Rclone Run. A Failed
        Attempt Leaves No Remote Behind.
        """
        if not username or len(username) > 254 or re.search(r"\s", username):
            raise ApiError(400, "Enter your Proton username or email address.")
        if not password or "\0" in password or "\0" in mailbox:
            raise ApiError(400, "Enter your Proton password.")
        if code and not re.fullmatch(r"\d{6}", code):
            raise ApiError(400, "The code has 6 digits.")
        if not self.lock.acquire(blocking=False):
            raise ApiError(409, "A transfer is running. Wait for it to finish.")
        try:
            self._exec(["config", "delete", self.remote], timeout=30)
            args = ["config", "create", self.remote, "protondrive", f"username={username}",
                    f"password={self.obscure(password)}"]
            if mailbox:
                args.append(f"mailbox_password={self.obscure(mailbox)}")
            made = self._exec([*args, "--no-obscure"], timeout=60)
            if made.returncode != 0:
                raise ApiError(502, "Could not save the login.")
            env = dict(os.environ)
            if code:
                env["RCLONE_CONFIG_" + re.sub(r"\W", "_", self.remote).upper() + "_2FA"] = code
            try:
                res = self._exec(["lsd", self.spec("/"), "--max-depth", "1", *RCLONE_FLAGS,
                                  "--retries", "1", "--low-level-retries", "1"],
                                 env=env, timeout=120)
            except subprocess.TimeoutExpired:
                res = None
            ok = res is not None and res.returncode == 0 and self.logged_in()
            if not ok:
                self._exec(["config", "delete", self.remote], timeout=30)
                text = res.stderr if res is not None else "rclone took too long."
                if "429" in text:
                    raise ApiError(429, "Proton asks to wait before more attempts. "
                                        "Try again in a few minutes.")
                tail = [ln for ln in text.strip().splitlines() if ln][-2:]
                raise ApiError(401, " ".join(tail) or "Login failed.")
        finally:
            self.lock.release()

    def logout(self):
        """Forgets The Account And Its Saved Session On This Machine."""
        if not self.lock.acquire(blocking=False):
            raise ApiError(409, "A transfer is running. Wait for it to finish.")
        try:
            self._exec(["config", "delete", self.remote], timeout=30)
        finally:
            self.lock.release()

    def run(self, args, timeout=600, env=None, extra=()):
        if not self.lock.acquire(blocking=False):
            raise ApiError(409, "A transfer is running. Wait for it to finish.")
        try:
            res = subprocess.run([self.bin, *args, *RCLONE_FLAGS, *extra], capture_output=True,
                                 text=True, errors="replace", timeout=timeout, env=env)
        except subprocess.TimeoutExpired:
            raise ApiError(504, "rclone took too long.")
        finally:
            self.lock.release()
        if res.returncode != 0:
            tail = [ln for ln in res.stderr.strip().splitlines() if ln][-3:]
            raise ApiError(502, " ".join(tail) or f"rclone exited with code {res.returncode}.")
        return res.stdout


