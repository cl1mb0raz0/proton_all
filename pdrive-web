def clean_name(name):
    if not isinstance(name, str) or not name or "/" in name or "\0" in name or name in (".", ".."):
        raise ApiError(400, "Invalid name.")
    return name


def local_path(value, must_exist=True):
    if not isinstance(value, str) or not value.startswith("/") or "\0" in value:
        raise ApiError(400, "Local paths must be absolute.")
    p = Path(os.path.normpath(value))
    if LOCAL_ROOT is not None:
        real = Path(os.path.realpath(p))
        if real != LOCAL_ROOT and LOCAL_ROOT not in real.parents:
            raise ApiError(403, f"Outside the allowed folder ({LOCAL_ROOT}).")
    if must_exist and not p.exists():
        raise ApiError(400, f"Does not exist: {p}")
    return p


def check_rel_paths(paths):
    if not isinstance(paths, list):
        raise ApiError(400, "Invalid list of paths.")
    for p in paths:
        if (not isinstance(p, str) or not p or p.startswith("/") or "\0" in p
                or "\n" in p or "\r" in p
                or any(seg in ("", ".", "..") for seg in p.split("/"))):
            raise ApiError(400, f"Invalid path: {p!r}")
    return paths


def write_list(paths, job):
    fd, name = tempfile.mkstemp(prefix="pdrive-files-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write("\n".join(paths) + "\n")
    job.cleanup.append(name)
    return name


def build_files_job(body, kind):
    """Copy Only The Listed Relative Paths Between A Local And A Remote Folder.

    `delete_paths` (Files That Exist Only At The Destination) Makes It A Mirror: They
    Are Removed Afterwards, And Only With The Confirmation Word.
    """
    paths = check_rel_paths(body.get("paths") or [])
    doomed = check_rel_paths(body.get("delete_paths") or [])
    if not paths and not doomed:
        raise ApiError(400, "Nothing selected.")
    if doomed and body.get("confirm") != "DELETE":
        raise ApiError(400, "Type DELETE to confirm.")
    flags, label = conflict_flags(body.get("conflict", 1))
    local = local_path(body.get("local_dir"))
    if not local.is_dir():
        raise ApiError(400, f"Not a directory: {local}")
    remote = rc.spec(str(body.get("remote_dir", "/")))
    src, dst = (str(local), remote) if kind == "upload_files" else (remote, str(local))
    job = Job(kind, bool(body.get("dry_run")), [], flags)
    if paths:
        job.steps.append({"desc": f"{len(paths)} file{'s' if len(paths) != 1 else ''}: {src} -> {dst}  [{label}]",
                          "args": ["copy", src, dst, "--files-from-raw", write_list(paths, job)]})
    if doomed:
        job.steps.append({"desc": f"delete {len(doomed)} file{'s' if len(doomed) != 1 else ''} only in {dst}",
                          "args": ["delete", dst, "--files-from-raw", write_list(doomed, job)]})
    for st in job.steps:
        st["state"] = "pending"
        st["progress"] = None
    return job


def build_job(body):
    kind = body.get("kind")
    if kind in ("upload_files", "download_files"):
        return build_files_job(body, kind)
    items = body.get("items")
    if kind not in ("download", "upload", "delete") or not isinstance(items, list) or not items:
        raise ApiError(400, "Nothing selected.")
    dry_run = bool(body.get("dry_run"))
    steps, flags = [], []

    if kind == "delete":
        if body.get("confirm") != "DELETE":
            raise ApiError(400, "Type DELETE to confirm.")
        dry_run = False
        for it in items:
            path = str(it.get("path", ""))
            name = clean_name(path.rstrip("/").split("/")[-1])
            is_dir = bool(it.get("is_dir"))
            steps.append({"desc": f"delete {'directory ' if is_dir else ''}{name}",
                          "args": ["purge" if is_dir else "deletefile", rc.spec(path)]})
    else:
        flags, label = conflict_flags(body.get("conflict", 1))
        if kind == "download":
            dest = local_path(body.get("dest"), must_exist=False)
            if not dest.is_dir():
                if not body.get("create_dest"):
                    raise ApiError(400, f"Destination does not exist: {dest}")
                if not dry_run:
                    try:
                        dest.mkdir(parents=True, exist_ok=True)
                    except OSError as e:
                        raise ApiError(400, f"Cannot create {dest}: {e.strerror}")
            for it in items:
                path = str(it.get("path", ""))
                name = clean_name(path.rstrip("/").split("/")[-1])
                if it.get("is_dir"):
                    steps.append({"desc": f"{name}/ -> {dest / name}  [{label}]",
                                  "args": ["copy", rc.spec(path), str(dest / name),
                                           "--create-empty-src-dirs"]})
                else:
                    steps.append({"desc": f"{name} -> {dest}/  [{label}]",
                                  "args": ["copy", rc.spec(path), str(dest)]})
        else:
            target = str(body.get("dest", ""))
            for it in items:
                src = local_path(it.get("path"))
                name = clean_name(src.name)
                if src.is_dir():
                    steps.append({"desc": f"{src}/ -> /{target.strip('/')}/{name}  [{label}]",
                                  "args": ["copy", str(src), rc.spec(f"{target}/{name}"),
                                           "--create-empty-src-dirs"]})
                else:
                    steps.append({"desc": f"{src} -> /{target.strip('/')}  [{label}]",
                                  "args": ["copy", str(src), rc.spec(target)]})

    for s in steps:
        s["state"] = "pending"
        s["progress"] = None
    return Job(kind, dry_run, steps, flags)


