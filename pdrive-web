CONFLICTS = {
    1: ([], "overwrite if different"),
    2: (["--ignore-existing"], "skip existing"),
    3: (["--update"], "only if newer"),
    4: (None, "keep both"),    # suffix carries a timestamp, built per job
}


def conflict_flags(choice):
    if choice not in CONFLICTS:
        raise ApiError(400, "Unknown conflict policy.")
    flags, label = CONFLICTS[choice]
    if flags is None:
        flags = ["--suffix", ".old-" + time.strftime("%Y%m%d-%H%M%S"), "--suffix-keep-extension"]
    return flags, label


class Job:
    def __init__(self, kind, dry_run, steps, flags):
        self.id = uuid.uuid4().hex[:12]
        self.kind = kind
        self.dry_run = dry_run
        self.steps = steps          # [{"desc", "args", "state", "progress"}]
        self.flags = flags
        self.state = "running"      # running | done | failed | cancelled
        self.created = time.time()
        self.finished = None
        self.log = []
        self.log_total = 0
        self.cancel_requested = False
        self.proc = None
        self.cleanup = []           # Temp Files Removed When The Job Ends
        self.mu = threading.Lock()

    def add_log(self, line):
        with self.mu:
            self.log.append(line)
            self.log_total += 1
            if len(self.log) > LOG_KEEP:
                del self.log[: len(self.log) - LOG_KEEP]

    def snapshot(self, tail=300):
        with self.mu:
            return {
                "id": self.id, "kind": self.kind, "dry_run": self.dry_run,
                "state": self.state, "created": self.created, "finished": self.finished,
                "steps": [{"desc": s["desc"], "state": s["state"], "progress": s["progress"]}
                          for s in self.steps],
                "log": self.log[-tail:], "log_total": self.log_total,
            }

    def cancel(self):
        self.cancel_requested = True
        proc = self.proc
        if proc and proc.poll() is None:
            proc.terminate()

    def run(self):
        failed = False
        try:
            for step in self.steps:
                if self.cancel_requested:
                    step["state"] = "skipped"
                    continue
                step["state"] = "running"
                code = self._run_step(step)
                if self.cancel_requested:
                    step["state"] = "cancelled"
                elif code == 0:
                    step["state"] = "done"
                else:
                    step["state"] = "failed"
                    failed = True
        finally:
            with self.mu:
                self.state = ("cancelled" if self.cancel_requested
                              else "failed" if failed else "done")
                self.finished = time.time()
            for f in self.cleanup:
                try:
                    os.unlink(f)
                except OSError:
                    pass
            if not self.dry_run and not self.kind.startswith("download"):
                invalidate_remote()
            rc.lock.release()

    def _run_step(self, step):
        cmd = [rc.bin, *step["args"], *RCLONE_FLAGS, *self.flags,
               "--use-json-log", "-v", "--stats", "1s"]
        if self.dry_run:
            cmd.append("--dry-run")
        self.add_log("$ " + step["desc"])
        try:
            self.proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                                         text=True, errors="replace", bufsize=1)
        except OSError as e:
            self.add_log(f"cannot start rclone: {e}")
            return 1
        for raw in self.proc.stderr:
            self._parse(raw.rstrip("\n"), step)
        return self.proc.wait()

    def _parse(self, raw, step):
        if not raw:
            return
        try:
            d = json.loads(raw)
        except ValueError:
            self.add_log(raw)
            return
        stats = d.get("stats")
        if stats:
            with self.mu:
                step["progress"] = {
                    "bytes": stats.get("bytes", 0), "total": stats.get("totalBytes", 0),
                    "speed": stats.get("speed", 0), "eta": stats.get("eta"),
                    "done": stats.get("transfers", 0), "count": stats.get("totalTransfers", 0),
                }
            return
        msg = d.get("msg", "")
        if d.get("object"):
            msg = f"{d['object']}: {msg}"
        if msg:
            self.add_log(msg if d.get("level") in ("info", "notice") else f"[{d.get('level')}] {msg}")


JOBS = {}
JOBS_MU = threading.Lock()


def start_job(job):
    if not rc.lock.acquire(blocking=False):
        raise ApiError(409, "Another operation is running. Wait for it to finish.")
    with JOBS_MU:
        JOBS[job.id] = job
        done = [j for j in JOBS.values() if j.state != "running"]
        for old in sorted(done, key=lambda j: j.created)[:-JOBS_KEEP]:
            JOBS.pop(old.id, None)
    threading.Thread(target=job.run, daemon=True).start()
    return job


def load_settings():
    try:
        data = json.loads(SETTINGS_FILE.read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def save_settings(data):
    SETTINGS_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = SETTINGS_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(data))
    os.replace(tmp, SETTINGS_FILE)


def sync_dir():
    """The Saved Local Folder, If It Is Still There And Still Allowed."""
    value = load_settings().get("sync_dir", "")
    try:
        p = local_path(value)
