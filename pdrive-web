COMPARE_CAP = 30000     # Entries Sent To The Browser
TIME_WINDOW = 2.0       # Seconds: Modification Times Closer Than This Are Equal
ISO_RE = re.compile(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.(\d+))?(Z|[+-]\d\d:\d\d)?$")


def parse_time(text):
    m = ISO_RE.match(text or "")
    if not m:
        return None
    base, frac, tz = m.groups()
    tz = "+00:00" if tz in (None, "Z") else tz
    try:
        return datetime.fromisoformat(f"{base}.{((frac or '') + '000000')[:6]}{tz}").timestamp()
    except ValueError:
        return None


def scan_local(root):
    found = {}
    for dirpath, _dirs, names in os.walk(root, followlinks=False):
        for name in names:
            full = os.path.join(dirpath, name)
            try:
                st = os.lstat(full)
            except OSError:
                continue
            if not os.path.isfile(full) or os.path.islink(full):
                continue        # Rclone Does Not Follow Links Either
            found[os.path.relpath(full, root).replace(os.sep, "/")] = (st.st_size, st.st_mtime)
            if len(found) > 200000:
                raise ApiError(413, "Too many files to compare (over 200000).")
    return found


REMOTE_CACHE = {}       # Remote Folder -> {"at", "took", "exists", "files"}
CACHE_MU = threading.Lock()
CACHE_TTL = 300         # Seconds A Listing Of Proton Stays Valid


def norm_dir(path):
    return "/" + "/".join(p for p in path.split("/") if p)


def invalidate_remote():
    with CACHE_MU:
        REMOTE_CACHE.clear()


def cached_remote(path):
    """A Recent Listing Of This Folder, Or Of A Folder Above It, Else None."""
    want = norm_dir(path)
    now = time.time()
    with CACHE_MU:
        for root, c in REMOTE_CACHE.items():
            if now - c["at"] > CACHE_TTL:
                continue
            if root == want:
                return c["files"], c["exists"], c["at"]
            if root == "/" or want.startswith(root + "/"):
                prefix = want[len(root):].strip("/") + "/" if root != "/" else want.strip("/") + "/"
                sub = {k[len(prefix):]: v for k, v in c["files"].items() if k.startswith(prefix)}
                if sub:
                    return sub, True, c["at"]
    return None


def last_scan_seconds(path):
    with CACHE_MU:
        c = REMOTE_CACHE.get(norm_dir(path))
    return c["took"] if c else None


def scan_remote(path, scan):
    """One Recursive Listing, Run As A Child Process That Can Be Cancelled."""
    if scan.cancel_requested:
        raise ApiError(499, "Cancelled.")
    cmd = [rc.bin, "lsjson", "-R", "--files-only", "--no-mimetype", rc.spec(path), *RCLONE_FLAGS]
    scan.proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                 text=True, errors="replace")
    try:
        out, err = scan.proc.communicate(timeout=3600)
    except subprocess.TimeoutExpired:
        scan.proc.kill()
        raise ApiError(504, "rclone took too long.")
    if scan.cancel_requested:
        raise ApiError(499, "Cancelled.")
    if scan.proc.returncode != 0:
        if "directory not found" in err.lower():
            return {}, False
        tail = [ln for ln in err.strip().splitlines() if ln][-3:]
        raise ApiError(502, " ".join(tail) or f"rclone exited with code {scan.proc.returncode}.")
    return {e["Path"]: (e["Size"], parse_time(e.get("ModTime"))) for e in json.loads(out or "[]")}, True


class Scan:
    """Reads Both Sides Of A Compare In The Background, With Progress And Cancel."""

    def __init__(self, local_dir, remote_dir, refresh):
        self.id = uuid.uuid4().hex[:12]
        self.local_dir, self.remote_dir, self.refresh = local_dir, remote_dir, refresh
        self.state = "running"      # running | done | failed | cancelled
        self.phase = "Reading the local folder"
        self.started = time.time()
        self.finished = None
        self.error = ""
        self.cached_at = None
        self.expected = last_scan_seconds(remote_dir)
        self.local, self.remote, self.remote_exists = {}, {}, True
        self.proc = None
        self.cancel_requested = False

    def cancel(self):
        self.cancel_requested = True
        if self.proc and self.proc.poll() is None:
            self.proc.kill()

    def run(self):
        try:
            self.local = scan_local(local_path(self.local_dir))
            hit = None if self.refresh else cached_remote(self.remote_dir)
            if hit:
                self.remote, self.remote_exists, self.cached_at = hit
            else:
                self.phase = "Reading Proton Drive"
                t0 = time.time()
                self.remote, self.remote_exists = scan_remote(self.remote_dir, self)
                with CACHE_MU:
                    REMOTE_CACHE[norm_dir(self.remote_dir)] = {
                        "at": time.time(), "took": time.time() - t0,
                        "exists": self.remote_exists, "files": self.remote}
            self.state = "done"
        except ApiError as e:
            self.state = "cancelled" if self.cancel_requested else "failed"
            self.error = e.message
        except Exception as e:
            self.state = "failed"
            self.error = f"{type(e).__name__}: {e}"
        finally:
            self.finished = time.time()
            rc.lock.release()

    def snapshot(self, ignore_time=False):
        out = {"id": self.id, "state": self.state, "phase": self.phase, "error": self.error,
               "elapsed": (self.finished or time.time()) - self.started,
               "expected": self.expected, "cached_at": self.cached_at}
        if self.state == "done":
            out["result"] = build_result(self, ignore_time)
        return out


SCANS = {}


def start_scan(local_dir, remote_dir, refresh):
    local_path(local_dir)           # Fail Early On A Bad Folder
    if not rc.lock.acquire(blocking=False):
        raise ApiError(409, "Another operation is running. Wait for it to finish.")
    scan = Scan(local_dir, remote_dir, refresh)
    for old in sorted(SCANS.values(), key=lambda x: x.started)[:-4]:
        SCANS.pop(old.id, None)
    SCANS[scan.id] = scan
    threading.Thread(target=scan.run, daemon=True).start()
    return scan


def classify(loc, rem, ignore_time):
    if loc and not rem:
        return "only_local"
    if rem and not loc:
        return "only_remote"
    (ls, lm), (rs, rm) = loc, rem
    diff = None if lm is None or rm is None else lm - rm
    close = diff is None or abs(diff) <= TIME_WINDOW
    if ls == rs and (ignore_time or close):
        return "same"
    if close:
        return "differs"
    return "local_newer" if diff > 0 else "remote_newer"


def build_result(scan, ignore_time):
    local, remote = scan.local, scan.remote
    counts = {k: 0 for k in ("only_local", "only_remote", "local_newer", "remote_newer", "differs", "same")}
    entries = []
    for rel in sorted(set(local) | set(remote), key=str.casefold):
        st = classify(local.get(rel), remote.get(rel), ignore_time)
        counts[st] += 1
        l, r = local.get(rel), remote.get(rel)
        entries.append({"path": rel, "status": st,
                        "local": {"size": l[0], "mtime": l[1]} if l else None,
                        "remote": {"size": r[0], "mtime": r[1]} if r else None})
    entries.sort(key=lambda e: e["status"] == "same")     # Differences First (Stable)
    return {"local_dir": str(local_path(scan.local_dir)), "remote_dir": norm_dir(scan.remote_dir),
            "remote_exists": scan.remote_exists, "counts": counts, "truncated": len(entries) > COMPARE_CAP,
            "entries": entries[:COMPARE_CAP]}


# ----------------------------------------------------------------------- Handlers
def list_remote(path):
    out = rc.run(["lsjson", rc.spec(path), "--no-mimetype"])
    entries = [{"name": e["Name"], "is_dir": bool(e["IsDir"]),
                "size": -1 if e["IsDir"] else e["Size"], "modified": e.get("ModTime", "")}
               for e in json.loads(out or "[]")]
    return {"path": "/" + "/".join(p for p in path.split("/") if p), "entries": entries}


def list_local(path, hidden):
    p = local_path(path)
    if not p.is_dir():
        raise ApiError(400, f"Not a directory: {p}")
    entries = []
    try:
        with os.scandir(p) as it:
            for e in it:
                if not hidden and e.name.startswith("."):
                    continue
                try:
                    st = e.stat()
                    is_dir = e.is_dir()
                except OSError:
                    continue
                entries.append({"name": e.name, "is_dir": is_dir,
                                "size": -1 if is_dir else st.st_size,
                                "modified": time.strftime("%Y-%m-%dT%H:%M:%S",
                                                          time.localtime(st.st_mtime))})
    except PermissionError:
        raise ApiError(403, f"Permission denied: {p}")
    try:
        free = shutil.disk_usage(p).free
    except OSError:
        free = None
    at_top = p == p.parent or (LOCAL_ROOT is not None and Path(os.path.realpath(p)) == LOCAL_ROOT)
    return {"path": str(p), "parent": None if at_top else str(p.parent),
            "entries": entries, "free": free, "writable": os.access(p, os.W_OK)}


class Handler(BaseHTTPRequestHandler):
    server_version = "pdrive-web"
    protocol_version = "HTTP/1.1"

    def log_message(self, *_):
        pass

    # -- Plumbing
    def reply(self, status, body, ctype="application/json", headers=()):
        if not isinstance(body, bytes):
            body = json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Content-Security-Policy",
                         "default-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'")
        for k, v in headers:
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    def cookie_ok(self):
        for part in self.headers.get("Cookie", "").split(";"):
            name, _, val = part.strip().partition("=")
            if name == self.server.cookie_name and hmac.compare_digest(val, self.server.key):
                return True
        return False

    def host_ok(self):
        return self.headers.get("Host", "") in self.server.allowed_hosts

    def origin_ok(self):
        origin = self.headers.get("Origin")
        return origin is None or origin in {f"http://{h}" for h in self.server.allowed_hosts}

    def read_body(self):
        if not self.headers.get("Content-Type", "").startswith("application/json"):
            raise ApiError(415, "JSON required.")
        n = int(self.headers.get("Content-Length") or 0)
        if n > MAX_BODY:
            raise ApiError(413, "Body too large.")
        try:
            data = json.loads(self.rfile.read(n) or b"{}")
        except ValueError:
            raise ApiError(400, "Invalid JSON.")
        if not isinstance(data, dict):
            raise ApiError(400, "Invalid JSON.")
        return data

    # -- Dispatch
    def do_GET(self):
        self.dispatch("GET")

    def do_POST(self):
        self.dispatch("POST")

    def dispatch(self, method):
        try:
            if not self.host_ok() or not self.origin_ok():
                raise ApiError(403, "Forbidden.")
            url = urlparse(self.path)
            query = parse_qs(url.query)

            if method == "GET" and url.path == "/":
                key = (query.get("k") or [""])[0]
                if key and hmac.compare_digest(key, self.server.key):
                    cookie = (f"{self.server.cookie_name}={self.server.key}; "
                              "HttpOnly; SameSite=Strict; Path=/")
                    return self.reply(302, b"", "text/plain",
                                      [("Location", "/"), ("Set-Cookie", cookie)])
                if not self.cookie_ok():
                    raise ApiError(403, "Open the link printed in the terminal where "
                                        "pdrive-web was started.")
                return self.reply(200, (WEB_DIR / "index.html").read_bytes(), "text/html; charset=utf-8")

            if method == "GET" and url.path in STATIC:
                f = WEB_DIR / STATIC[url.path]
                ctype = mimetypes.guess_type(f.name)[0] or "application/octet-stream"
                return self.reply(200, f.read_bytes(), ctype)

            if url.path.startswith("/api/"):
                if not self.cookie_ok():
                    raise ApiError(401, "Session expired. Open the link from the terminal again.")
                body = self.read_body() if method == "POST" else {}
                return self.reply(200, self.api(method, url.path[5:], query, body))

            raise ApiError(404, "Not found.")
        except ApiError as e:
            self.reply(e.status, {"error": e.message})
        except Exception as e:      # Never Leave The Browser Hanging
            self.reply(500, {"error": f"{type(e).__name__}: {e}"})

    def api(self, method, route, q, body):
        arg = lambda k, d="": (q.get(k) or [d])[0]

        if method == "GET":
            if route == "status":
                chosen = sync_dir()
                return {"rclone": rc.version, "remote": rc.remote,
                        "home": str(LOCAL_ROOT or Path.home()), "local_root": bool(LOCAL_ROOT),
                        "local_label": os.environ.get("PDRIVE_LOCAL_LABEL", ""),
                        "default_local": chosen or LOCAL_DEFAULT, "sync_dir": chosen,
                        "busy": rc.lock.locked(), "logged_in": rc.logged_in(),
                        "account": rc.account()}
            if route == "ls":
                require_login()
                return list_remote(arg("path", "/"))
            if route == "local":
                return list_local(arg("path") or str(LOCAL_ROOT or Path.home()), arg("hidden") == "1")
            m = re.fullmatch(r"compare/([0-9a-f]+)", route)
            if m:
                scan = SCANS.get(m.group(1))
                if not scan:
                    raise ApiError(404, "Unknown comparison.")
                return scan.snapshot(arg("ignore_time") == "1")
            if route == "size":
                require_login()
                out = rc.run(["size", "--json", rc.spec(arg("path", "/"))])
                return json.loads(out)
            if route == "jobs":
                with JOBS_MU:
                    jobs = sorted(JOBS.values(), key=lambda j: -j.created)
                return {"jobs": [j.snapshot(tail=0) for j in jobs]}
            m = re.fullmatch(r"jobs/([0-9a-f]+)", route)
            if m:
                job = JOBS.get(m.group(1))
                if not job:
                    raise ApiError(404, "Unknown job.")
                return job.snapshot()
        else:
            if route == "mkdir":
                require_login()
                name = clean_name(body.get("name"))
                rc.run(["mkdir", rc.spec(f"{body.get('path', '/')}/{name}")])
                invalidate_remote()
                return {"ok": True}
            if route == "login":
                invalidate_remote()
                rc.login(str(body.get("username", "")).strip(), str(body.get("password", "")),
                         str(body.get("mailbox_password", "")), str(body.get("code", "")).strip())
                return {"ok": True}
            if route == "logout":
                rc.logout()
                invalidate_remote()
                return {"ok": True}
            if route == "settings":
                p = local_path(body.get("sync_dir"), must_exist=False)
                if body.get("create"):
                    p.mkdir(parents=True, exist_ok=True)
                if not p.is_dir():
                    raise ApiError(400, f"Not a folder: {p}")
                save_settings({**load_settings(), "sync_dir": str(p)})
                return {"ok": True, "sync_dir": str(p)}
            if route == "local_mkdir":
                parent = local_path(body.get("path"))
                made = local_path(str(parent / clean_name(body.get("name"))), must_exist=False)
                made.mkdir(exist_ok=True)
                return {"ok": True, "path": str(made)}
            if route == "compare/start":
                require_login()
                scan = start_scan(str(body.get("local", "")), str(body.get("remote", "/")) or "/",
                                  bool(body.get("refresh")))
                return scan.snapshot()
            m = re.fullmatch(r"compare/([0-9a-f]+)/cancel", route)
            if m:
                scan = SCANS.get(m.group(1))
                if scan:
                    scan.cancel()
                return {"ok": True}
            if route == "jobs":
                require_login()
                return start_job(build_job(body)).snapshot()
            m = re.fullmatch(r"jobs/([0-9a-f]+)/cancel", route)
            if m:
                job = JOBS.get(m.group(1))
                if not job:
                    raise ApiError(404, "Unknown job.")
                job.cancel()
                return {"ok": True}
            if route == "quit":
                threading.Thread(target=self.server.shutdown, daemon=True).start()
                return {"ok": True}
        raise ApiError(404, "Unknown endpoint.")


# --------------------------------------------------------------------------- Main
def main():
    ap = argparse.ArgumentParser(description="Local web UI for Proton Drive (rclone).")
    ap.add_argument("--port", type=int, default=DEFAULT_PORT)
    ap.add_argument("--no-browser", action="store_true", help="only print the link")
    ap.add_argument("--host", default=BIND_HOST,
                    help="address to bind (default 127.0.0.1; 0.0.0.0 only inside a container)")
    args = ap.parse_args()

    if not rc.locate():
        sys.exit("No rclone with Proton Drive support found. Run ./install.sh first.")
    rc.pick_remote()

    server = None
    for port in range(args.port, args.port + 20):
        try:
            server = ThreadingHTTPServer((args.host, port), Handler)
            break
        except OSError:
            continue
    if server is None:
        sys.exit(f"No free port in {args.port}-{args.port + 19}.")
    server.daemon_threads = True
    server.key = FIXED_KEY or secrets.token_urlsafe(32)
    shown = int(PUBLIC_PORT) if PUBLIC_PORT.isdigit() else port
    server.cookie_name = f"pdrive_{shown}"
    server.allowed_hosts = {f"127.0.0.1:{shown}", f"localhost:{shown}"}

    url = f"http://127.0.0.1:{shown}/?k={server.key}"
    print(f"pdrive-web  {rc.version}  remote '{rc.remote}:'", flush=True)
    print(f"Open: {url}", flush=True)
    print("Ctrl+C to stop.", flush=True)
    if not args.no_browser:
        threading.Timer(0.4, webbrowser.open, (url,)).start()

    signal.signal(signal.SIGTERM, lambda *_: threading.Thread(target=server.shutdown).start())
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        with JOBS_MU:
            for j in JOBS.values():
                if j.state == "running":
                    j.cancel()
        server.server_close()
        print("Bye.")


if __name__ == "__main__":
    main()
